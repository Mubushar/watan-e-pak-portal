# ===========================================================================
# Arz-e-Pak portal - repository ignore rules
# ===========================================================================

# ---- OS / editor cruft ----
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*~
*.swp
*.swo
.vscode/
.idea/

# ---- Office / Word temp + lock files ----
~$*
~WRL*.tmp
*.tmp

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
.installed.cfg
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Secrets / local environment (never commit) ----
.env
.env.*
!.env.example
*.local
*.pem
*.key
secrets.*

# ---- Logs ----
*.log
logs/

# ---- PostgreSQL migration output (generated; re-run `migrate_to_postgres.py all`)
db/data/

# ---- Live portal database (SQLite fallback for durable storage; see backend/storage.py)
backend/data/
db/load.sql
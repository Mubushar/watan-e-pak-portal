	<string>Take photos of your property to add them to a listing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos of your property to add them to a listing.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows a development backend on your local network over http. Use https in production. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

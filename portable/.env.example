# Backend URL baked into packaged builds (desktop/mobile). Users can still change it
# in Profile -> Server. Leave unset in `npm run dev` to use the Vite proxy (/api).
# VITE_API_BASE=https://api.watanepak.pk
# Where the dev proxy forwards /api (the FastAPI backend).
VITE_API_TARGET=http://127.0.0.1:8000

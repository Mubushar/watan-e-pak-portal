# Copy to backend/.env (never commit the real file) — loaded automatically at startup.
# Without any of these, OTP codes are NOT sent anywhere: the API returns them as
# `dev_otp` and the apps show a "Test mode" hint. See docs/ADMINISTRATION_GUIDE.md §4.4.

# ---- E-mail OTP (any SMTP server) ----
# Gmail / Google Workspace: smtp.gmail.com:587 with an App Password (not your login password).
PORTAL_SMTP_HOST=
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USER=
PORTAL_SMTP_PASSWORD=
PORTAL_SMTP_FROM=Arz-e-Pak <no-reply@yourdomain.pk>
# starttls (587) | ssl (465) | none
PORTAL_SMTP_SECURITY=starttls

# ---- Mobile OTP: twilio | whatsapp | webhook ----
PORTAL_SMS_PROVIDER=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp Business Cloud API (needs an approved "authentication" template)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
PORTAL_WHATSAPP_OTP_TEMPLATE=
PORTAL_WHATSAPP_OTP_LANG=en
PORTAL_WHATSAPP_OTP_BUTTON=1

# Any HTTP SMS gateway (e.g. a Pakistani bulk-SMS provider).
# Placeholders: {to} +9230..., {to_digits} 9230..., {to_local} 030..., {message}, {code}
PORTAL_SMS_WEBHOOK_URL=
PORTAL_SMS_WEBHOOK_METHOD=POST
PORTAL_SMS_WEBHOOK_HEADERS={"Authorization": "Bearer YOUR_KEY"}
PORTAL_SMS_WEBHOOK_BODY={"to": "{to_digits}", "message": "{message}"}

# ---- OpenAI: the assistant's AI model AND voice (the only AI provider) ----
# Without it the assistant runs in "basic mode" (search templates, voice off).
OPENAI_API_KEY=
# Chat model for typed messages and voice notes
# OPENAI_MODEL=gpt-5.6-luna
# Live voice agent (Realtime API, speech-to-speech over WebRTC)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Speech-to-text for voice notes and live captions (Urdu comes back in Urdu script)
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Text-to-speech for voice-note replies
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Built-in voice: marin or cedar sound best (also alloy, ash, ballad, coral, echo, sage, shimmer, verse)
# OPENAI_VOICE=marin
# Your own custom OpenAI voice (voice_...), used instead of OPENAI_VOICE everywhere
# OPENAI_VOICE_ID=
# Optional: Azure OpenAI / proxy base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- AI cost protection (the AI endpoints spend your OpenAI credit) ----
# Limits per signed-in user, or per IP address for guests. 0 = no limit.
# AI_CHAT_PER_MINUTE=30
# AI_VOICE_PER_MINUTE=30
# AI_LIVE_PER_HOUR=20
# 1 = only signed-in users may use the AI assistant
# AI_REQUIRE_SIGNIN=0
# 1 = the backend sits behind your own reverse proxy (nginx, Caddy, a load balancer);
# guests are then told apart by X-Forwarded-For. Leave 0 otherwise - the header is easy to fake.
# AI_TRUST_PROXY=0

# ---- Server address (python main.py) ----
# 0.0.0.0 makes the API reachable from phones / other PCs on your network
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=8000

# Return codes in API responses even when a provider is configured (dev only).
# Unset = expose only for channels with no provider.
# PORTAL_AUTH_EXPOSE_OTP=0
